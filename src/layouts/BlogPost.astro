---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import AdSlot from '../components/AdSlot.astro';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage, category, tags } = Astro.props;
---

<html lang="ko">
	<head>
		<BaseHead title={title} description={description} />
		<style>
			main {
				width: calc(100% - 2em);
				max-width: 100%;
				margin: 0;
			}
			.hero-image {
				width: 100%;
			}
			.hero-image img {
				display: block;
				margin: 0 auto;
				border-radius: 12px;
				box-shadow: var(--box-shadow);
			}
			.prose {
				width: 720px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 1em;
				color: rgb(var(--gray-dark));
			}
			.title {
				margin-bottom: 1em;
				padding: 1em 0;
				text-align: center;
				line-height: 1.2;
			}
			.title h1 {
				margin: 0.3em 0 0.5em 0;
			}
			.category-badge {
				display: inline-block;
				padding: 0.2em 0.7em;
				border-radius: 999px;
				background: rgba(var(--gray-light), 1);
				color: rgb(var(--gray-dark));
				font-size: 0.85rem;
				font-weight: 700;
			}
			.date {
				margin-top: 0.5em;
				margin-bottom: 0.5em;
				color: rgb(var(--gray));
				font-size: 0.9rem;
			}
			.last-updated-on {
				font-style: italic;
			}
			.tags {
				display: flex;
				flex-wrap: wrap;
				gap: 0.5em;
				margin-top: 2.5em;
				padding-top: 1em;
				border-top: 1px solid rgb(var(--gray-light));
			}
			.tag {
				font-size: 0.85rem;
				color: rgb(var(--gray));
				background: rgba(var(--gray-light), 0.7);
				padding: 0.2em 0.6em;
				border-radius: 6px;
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article>
				<div class="hero-image">
					{heroImage && <Image width={1020} height={510} src={heroImage} alt="" />}
				</div>
				<div class="prose">
					<div class="title">
						{category && <span class="category-badge">{category}</span>}
						<div class="date">
							<FormattedDate date={pubDate} />
							{
								updatedDate && (
									<div class="last-updated-on">
										수정일: <FormattedDate date={updatedDate} />
									</div>
								)
							}
						</div>
						<h1>{title}</h1>
						<hr />
					</div>
					<AdSlot position="top" />
					<slot />
					<AdSlot position="bottom" />
					{
						tags && tags.length > 0 && (
							<div class="tags">
								{tags.map((tag) => (
									<span class="tag">#{tag}</span>
								))}
							</div>
						)
					}
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>
